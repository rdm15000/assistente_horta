# ---------------------------------------------------------------------------
# Modelo de configuração do Assistente de Extensão Rural.
#
# Copie este arquivo para `config.env` e preencha os valores:
#     cp config.env-example config.env     (Linux / macOS)
#     copy config.env-example config.env   (Windows)
#
# O `config.env` fica apenas na sua máquina (está no .gitignore).
# Este arquivo-modelo, sim, vai para o repositório — sem nenhuma chave.
# ---------------------------------------------------------------------------

# Chave da API do Google Gemini. Gere a sua, de graça, em:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos usados (opcional — se deixar em branco, usa esses padrões)
CHAT_MODEL=gemini-flash-latest
EMBED_MODEL=gemini-embedding-001

# Servidor web (opcional)
PORT=5000
FLASK_DEBUG=1
